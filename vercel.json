{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "packages/api",
      "framework": "nextjs"
    },
    "web": {
      "root": "packages/web",
      "framework": "nextjs"
    },
    "worker": {
      "root": "packages/worker",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
